// Cloudflare Workers 배포 설정 (정적 에셋만 제공).
// 대시보드: 컴퓨트 → Workers & Pages → 만들기 → 저장소 가져오기 → 배포 명령 `npx wrangler deploy`
// 서버(멀티 방·시계 중계)는 net/ 의 별도 Worker `dicekeep-net` 이다 — 이 Worker 에 main/Durable Object 를 넣으면 브랜치 프리뷰 URL 이 사라진다.
{
  "$schema": "https://esm.sh/wrangler/config-schema.json",
  "name": "dicekeep",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./",
    "not_found_handling": "404-page"
  }
}
