{
  "name": "dicekeep",
  "version": "1.0.0",
  "private": true,
  "description": "주사위 성채 (Dicekeep) — 캔버스 타워 디펜스. 웹은 정적 배포, 앱은 Capacitor 로 www/ 를 감싼다.",
  "scripts": {
    "fonts": "node tools/copy-fonts.mjs",
    "build:www": "node tools/build-www.mjs",
    "art:manifest": "node tools/art-manifest.mjs",
    "art:golden-jobs": "node tools/golden-slice-jobs.mjs --out=tools/jobs/golden-slice.json",
    "art:golden-candidates": "node tools/golden-slice-jobs.mjs --candidates=2 --out=gen/jobs/golden-slice-candidates.json",
    "measure:asset-load": "node tools/asset-load-budget.mjs",
    "test:asset-load": "node --test tools/asset-load-budget.test.mjs",
    "test:art-pipeline": "node tools/art-pipeline-test.mjs && node tools/golden-slice-jobs.test.mjs && node --test tools/asset-load-budget.test.mjs && node tools/art-manifest.mjs --check",
    "cap:sync": "npm run build:www && npx cap sync",
    "android": "npx cap open android",
    "serve:www": "http-server www -p 8140 -c-1",
    "test:net": "cd net && npm test",
    "test:progression": "node tools/progression-test.cjs && node tools/collection-test.cjs && node tools/tree-progression-test.cjs",
    "test:deck-rules": "node tools/deck-rules-test.cjs",
    "test:deck-collection": "node tools/e2e/deck-collection.cjs",
    "test:deck-combat": "node tools/e2e/deck-combat.cjs",
    "test:tree-collection": "node tools/e2e/tree-collection.cjs",
    "test:tree-combat-rules": "node tools/tree-combat-test.cjs",
    "test:tree-combat": "node tools/e2e/tree-combat.cjs",
    "test:tree-resume": "node tools/e2e/tree-resume.cjs",
    "measure:deck": "node tools/e2e/deck-balance.cjs",
    "test:commerce": "cd commerce && npm test",
    "test:game-modes": "node tools/e2e/game-modes.cjs",
    "test:pure-luck": "node tools/e2e/pure-luck-parity.cjs",
    "test:pure-luck-baseline": "node tools/e2e/pure-luck-baseline.cjs",
    "test:boss-matchup": "node tools/e2e/boss-matchup.cjs",
    "test:tower-move": "node tools/e2e/tower-move.cjs",
    "test:splash-hit": "node tools/e2e/splash-hit.cjs",
    "measure:clear-rate": "node tools/e2e/pure-luck-clearrate.cjs",
    "measure:boss-board": "node tools/e2e/boss-board-req.cjs",
    "test:pure-main": "node tools/pure-main-rules-test.cjs && node tools/e2e/pure-luck-parity.cjs --main-baseline",
    "test:purchase-review": "node tools/e2e/purchase-review.cjs",
    "test:commerce-client": "node tools/commerce-client-test.cjs",
    "measure:growth": "node tools/e2e/growth-balance.cjs",
    "test:run-resume": "node tools/e2e/run-resume.cjs",
    "test:extreme-multi": "node tools/e2e/extreme-multiplayer.cjs",
    "test:campaign": "node tools/e2e/campaign.cjs",
    "measure:campaign": "node tools/e2e/campaign.cjs --full-combat",
    "test:boss-locomotion": "node tools/e2e/boss-locomotion.cjs",
    "test:combat-motion": "node tools/e2e/combat-motion.cjs",
    "test:casual-world": "node tools/e2e/tower-emitter.cjs && node tools/e2e/casual-world.cjs",
    "test:biped-knees": "node tools/directional-rig-test.mjs && node tools/audit-biped-knees.mjs --check && node tools/e2e/biped-knees-runtime.cjs",
    "test:battle-persistence": "node tools/battle-persistence-test.cjs",
    "test:battle-multi": "node tools/e2e/battle-multiplayer.cjs",
    "measure:deck-ranking": "node tools/e2e/deck-ranking.cjs --stage=validate",
    "report:deck-ranking": "node tools/e2e/deck-ranking-report.cjs",
    "test:free-progression": "node tools/battle-reward-test.cjs && node tools/battle-persistence-test.cjs",
    "measure:economy": "node tools/economy-model.cjs",
    "measure:battle": "node tools/e2e/battle-matrix.cjs",
    "test:battle-account": "node --test tools/e2e/battle-account.cjs",
    "test:liveops": "node tools/liveops-rules-test.cjs",
    "test:rewards-ui": "node tools/e2e/rewards-ui.cjs",
    "test:rewards-visual": "node tools/e2e/rewards-visual.cjs",
    "test:rewards-integration": "node tools/e2e/rewards-integration.cjs",
    "test:mail-admin": "node tools/e2e/mail-admin.cjs",
    "test:home": "node tools/reward-notifications-test.cjs && node tools/reward-refresh-race-test.cjs && node tools/e2e/home-rewards.cjs"
  },
  "dependencies": {
    "@capacitor-community/safe-area": "^7.0.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@fontsource/do-hyeon": "^5.0.0",
    "@fontsource/noto-sans-kr": "^5.0.0",
    "http-server": "^14.1.1",
    "playwright-core": "1.63.0",
    "sharp": "^0.34.0"
  }
}
