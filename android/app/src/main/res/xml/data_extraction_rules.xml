<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- API 31+: exclude the entire default WebView profile for both transfer types. -->
    <cloud-backup>
        <exclude domain="root" path="app_webview" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview" />
    </device-transfer>
</data-extraction-rules>
