{
  "name": "dicekeep-commerce",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-08",
  "workers_dev": false,
  "vars": { "PAYMENT_MODE": "disabled", "ENABLE_LIVE_PURCHASES": "false" },
  "durable_objects": { "bindings": [{ "name": "COMMERCE", "class_name": "CommerceLedger" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CommerceLedger"] }]
}
